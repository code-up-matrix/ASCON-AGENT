# Local Eris development only. Copy to the pinned Eris checkout as .env.local.
# Choose ONE inference provider for an improving run; all are optional for frozen tests.
OLLAMA_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Additional providers for LOCAL development. Both keys may be stored here;
# the launcher maps only the selected key to Eris's OpenAI-compatible transport.
# These providers are not listed in the organizer's published inference services.
OPENROUTER_API_KEY=
AKASHML_API_KEY=
ASCON_LLM_PROVIDER=openrouter
# Optional provider-specific model IDs (blank uses the default in llm/constants.mjs).
OPENROUTER_MODEL=
AKASHML_MODEL=
# Do not add OPENAI_BASE_URL or copy these keys into OPENAI_API_KEY manually.
# Use make ascon-llm-check / ascon-llm-smoke / ascon-llm-backtest.

# For direct Ollama/OpenAI/Anthropic use, select the model in ascon-improving.yaml:
# the roster explicitly sets ERIS_LLM_MODEL=gpt-oss:120b by default.
# Optional local Ollama instead of Cloud (also change the roster's model):
# ERIS_OLLAMA_BASE_URL=http://127.0.0.1:11434/api

# Local Anvil keys are provided by Eris; do not put a funded wallet's key here.
# Contest credentials are registered separately with the organizer, never in the ZIP.
